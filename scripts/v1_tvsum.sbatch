#!/bin/bash
#SBATCH --job-name=v1_tvsum
#SBATCH --account=tesis
#SBATCH --qos=a-tesis
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --exclude=g001
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=23:00:00
#SBATCH --output=logs/%x_%j.out
# Corrida limpia v1 (contrato cava-run-v1) con el stack final, en directorio nuevo: tvsum
set -euo pipefail
source /etc/profile.d/lmod.sh
module load miniconda/3.0 cuda/12.8
conda activate segloop
export PYTHONNOUSERSITE=1 HF_HOME=/home/edgar.chambilla/Tesis/SegLoop/data/hf_cache HF_HUB_OFFLINE=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
cd /home/edgar.chambilla/Tesis/CAVA
python scripts/cava_run.py /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/0tmA_C6XwfM.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/37rzWOQsNIw.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/3eYKfiOEJNs.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/4wU_LUjG5Ic.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/91IHQYk1IQM.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/98MoyGZKHXc.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/akI8YFjEmUw.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/AwmHb44_ouw.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/b626MiF1ew4.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/Bhxk-O1Y7Ho.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/byxOvuiIJV0.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/cjibtmSLxQ4.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/E11zDS9XGzg.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/EE-bNr36nyA.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/eQu1rNs0an0.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/-esJrBWj2d8.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/EYqVtI9YWJA.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/fWutDQy1nnY.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/GsAD1KT1xo8.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/gzDbaEs1Rlg.mp4:film /home/edgar.chambilla/Tesis/SegLoop/data/tvsum/ydata-tvsum50-v1_1/video/Hl-__g2gn_A.mp4:film /home/edgar.chambill